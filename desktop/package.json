{
  "name": "line-rush-desktop",
  "productName": "Line Rush",
  "private": true,
  "version": "1.1.0",
  "description": "Two buttons. Real beats. Don't miss. A two-lane rhythm game.",
  "author": "Line Rush",
  "homepage": "https://github.com/w7llywonka/rythym-web",
  "repository": {
    "type": "git",
    "url": "https://github.com/w7llywonka/rythym-web.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node copy-web.js && electron .",
    "dist": "node copy-web.js && electron-builder --publish never",
    "release": "node copy-web.js && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.linerush.game",
    "productName": "Line Rush",
    "copyright": "Copyright © 2026 Line Rush",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "*.js",
      "preload.cjs",
      "app-config.json",
      "build/icon.png",
      "web/**/*",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "artifactName": "Line-Rush-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Line-Rush-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "license": "build/installer/license.txt",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "shortcutName": "Line Rush",
      "uninstallDisplayName": "Line Rush",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": false,
      "installerLanguages": [
        "en_US"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.music-games"
    },
    "dmg": {
      "title": "Line Rush",
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 390,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game;ArcadeGame",
      "icon": "build/icons",
      "synopsis": "Two-button rhythm game",
      "description": "Two buttons. Real beats. A two-lane rhythm game with online leaderboards, 1v1 battles and charts for your own music.",
      "maintainer": "Line Rush",
      "vendor": "Line Rush",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Line Rush",
          "GenericName": "Rhythm Game",
          "Keywords": "rhythm;music;beat;game;arcade;",
          "StartupWMClass": "line-rush"
        }
      }
    },
    "deb": {
      "packageCategory": "games",
      "priority": "optional"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "w7llywonka",
        "repo": "rythym-web",
        "releaseType": "release"
      }
    ]
  },
  "desktopName": "line-rush.desktop"
}
