{
  "name": "line-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node server.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "charts": "node --experimental-strip-types scripts/chart-objects.ts",
    "tracks": "node --experimental-strip-types scripts/add-tracks.ts",
    "app": "npm run build && npm --prefix desktop start",
    "app:dist": "npm run build && npm --prefix desktop run dist"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "audio-decode": "^2.2.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "redis": "^4.7.1"
  }
}
